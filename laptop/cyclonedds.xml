<?xml version="1.0" encoding="UTF-8"?>
<!--
  Laptop-side CycloneDDS config. Copy this to the laptop and point
  CYCLONEDDS_URI at it:

      export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
      export CYCLONEDDS_URI=file:///path/to/cyclonedds.xml
      export ROS_DOMAIN_ID=30

  Change NetworkInterface to the laptop's own interface name; the rest matches
  what the car runs (inlined in the container's .bashrc, not read from here).
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">

    <General>
      <!-- Without this Cyclone binds every interface it finds and sends
           discovery on all of them. -->
      <Interfaces>
        <NetworkInterface name="CHANGE_ME"/>
      </Interfaces>

      <!-- Keeps bulk data off multicast, which an AP sends at its lowest rate
           with no retries. Only bites with more than one subscriber. -->
      <AllowMulticast>spdp</AllowMulticast>

      <!-- The 14720B default is IP-fragmented into ~10 frames, and losing one
           discards all of them. -->
      <MaxMessageSize>1400B</MaxMessageSize>
    </General>

    <Internal>
      <!-- Unset, Cyclone takes rmem_default (208KB on stock Ubuntu). /map
           arrives as a ~198KB burst and overflows it into a retransmit storm.
           Raise net.core.rmem_max on the laptop too, or this is capped. -->
      <SocketReceiveBufferSize min="2MB"/>
    </Internal>

  </Domain>
</CycloneDDS>
